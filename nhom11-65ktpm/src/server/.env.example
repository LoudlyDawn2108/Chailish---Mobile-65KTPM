PROJECT_NAME="ChaiLish API"
API_V1_STR="/api"
ENVIRONMENT="development"

# PostgreSQL 16 (khi chạy bằng docker compose, host là "db")
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/chailish_db"

# JWT
SECRET_KEY="chailish_super_secret_jwt_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Dịch vụ bên ngoài (chỉ lưu trên server, không đưa vào app)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
AZURE_SPEECH_KEY="your_azure_speech_key_here"
AZURE_SPEECH_REGION="southeastasia"
